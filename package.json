{
  "name": "forge",
  "displayName": "Forge",
  "description": "The Universal Sidecar for AI Orchestration",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge-sidebar",
          "title": "Forge",
          "icon": "resources/forge-icon.svg"
        }
      ]
    },
    "views": {
      "forge-sidebar": [
        {
          "type": "webview",
          "id": "forge.sidebar",
          "name": "Forge Control"
        }
      ]
    },
    "commands": [
      {
        "command": "forge.refresh",
        "title": "Forge: Refresh UI",
        "icon": "$(refresh)"
      },
      {
        "command": "forge.configureWatsonx",
        "title": "Forge: Configure Watsonx Credentials",
        "icon": "$(gear)"
      },
      {
        "command": "forge.verifyWatsonx",
        "title": "Forge: Verify Watsonx Connection",
        "icon": "$(check)"
      }
    ],
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.watsonx.apiKey": {
          "type": "string",
          "default": "",
          "description": "IBM Watsonx API Key (stored securely in workspace settings)",
          "scope": "resource"
        },
        "forge.watsonx.projectId": {
          "type": "string",
          "default": "",
          "description": "IBM Watsonx Project ID",
          "scope": "resource"
        },
        "forge.server.port": {
          "type": "number",
          "default": 3000,
          "description": "Port for the Forge MCP server"
        },
        "forge.budget.maxBobcoins": {
          "type": "number",
          "default": 40,
          "description": "Maximum Bobcoins budget for AI operations"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run build:renderer && tsc -p ./",
    "build:renderer": "vite build",
    "watch": "tsc -watch -p ./",
    "watch:renderer": "vite build --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.6",
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.10"
  }
}
